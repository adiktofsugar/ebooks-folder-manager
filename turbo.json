{
    "$schema": "./node_modules/turbo/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "cache": true,
            "outputs": ["dist/**"]
        },
        "dev": {
            "persistent": true,
            "cache": false,
            "with": ["//#dev:server", "//#dev:copy"]
        },
        "//#dev:server": {
            "persistent": true,
            "cache": false
        },
        "//#dev:copy": {
            "persistent": true,
            "cache": false
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "fix": {
            "dependsOn": ["^fix"]
        }
    }
}