{
	"$schema": "./node_modules/turbo/schema.json",
	"ui": "tui",
	"dangerouslyDisablePackageManagerCheck": true,
	"tasks": {
		"build": {
			"dependsOn": ["^build", "lint"],
			"cache": true,
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["^dev", "build", "fix"],
			"interruptible": true,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"fix": {
			"dependsOn": ["^fix"]
		}
	}
}
